# Copy to .env (gitignored) and fill in. None of these are required for offline runs.

# ===== AI providers (Phase B) =====
# Set whichever provider(s) you want SpecGen to enrich docs with.
# If both are unset, SpecGen falls back to a deterministic local stub.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Claude Code subscription billing — uses your Claude Pro/Max subscription
# instead of the metered Anthropic API. The production image ships the `claude`
# CLI; set this OAuth token to enable the `claude_code` provider.
#
# Get a token: `claude setup-token` on a machine with your subscription, then
# copy the token here. (Do NOT set ANTHROPIC_API_KEY at the same time — the
# subprocess client strips it before spawning to ensure subscription billing.)
CLAUDE_CODE_OAUTH_TOKEN=

# ===== Server =====
# DEFAULT: 127.0.0.1 — the server is unauthenticated. Binding to a non-loopback
# address requires SPECGEN_ALLOW_PUBLIC=1 to be set explicitly, and that mode is
# UNSAFE until the password gate ships in Phase E. See SECURITY.md.
SPECGEN_BIND_HOST=127.0.0.1
SPECGEN_BIND_PORT=6101
# SPECGEN_ALLOW_PUBLIC=1   # uncomment + own the risk to bind non-loopback

# Path to the SQLite DB. Containers MUST set this to a path inside a mounted
# volume so the DB + master key survive `docker rm`. Default: ~/.specgen/specgen.db
# SPECGEN_DB=/data/specgen.db

# ===== Connectors (Phase D) =====
# Master key used to encrypt connector tokens (GitHub PATs, Confluence API
# tokens) at rest via AES-256-GCM. If unset, a key is auto-generated on first
# boot at <dirname(SPECGEN_DB)>/secret.key (chmod 0600). Back this file up
# alongside specgen.db — losing it makes ALL stored tokens unrecoverable.
# Set explicitly for 12-factor deployments where you want the key in your
# secret manager, NOT on the volume:
#   - 32 random bytes, base64-encoded:  `openssl rand -base64 32`
# SPECGEN_SECRET_KEY=

# Override host port for the production Docker container (HOST:CONTAINER).
# Container always listens on 6101 internally; this only affects host binding.
# Avoid Chrome's unsafe-port list (6000, 6665-6669, etc) for browser access.
# SPECGEN_HOST_PORT=6101

# Bind-mount host directory for project codebases (containers only). Inside
# SpecGen, a project's source.localPath would be /workspaces/<your-project>.
# WORKSPACES_HOST_DIR=./workspaces

# ===== Test fixtures =====
# Sibling-directory path to MockPMS (the .NET + React test target). Smoke tests
# look for it here when SPECGEN_MOCKPMS_PATH is set, otherwise at ../MockPMS.
SPECGEN_MOCKPMS_PATH=
